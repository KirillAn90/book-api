<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Список книг</title>
</head>
<body>
  <h1>Библиотека</h1>
  <a href="/book/create">Добавить книгу</a>
  <ul>
    <% books.forEach(book => { %>
      <li>
        <a href="/book/<%= book.id %>"><%= book.title %></a>
        <a href="/book/update/<%= book.id %>">Редактировать</a>
      </li>
    <% }); %>
  </ul>
</body>
</html>
